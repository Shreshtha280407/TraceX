# Where the browser-side API client sends requests. Leave empty (the
# default) to use same-origin relative paths -- required in dev, since the
# backend deliberately sets no CORS headers (see
# docs/architecture/security-boundaries-v1.md) and a browser cannot call a
# different origin directly without them. Relative paths are proxied to the
# real backend by Vite's dev server -- see VITE_API_PROXY_TARGET below.
VITE_API_BASE_URL=

# Where Vite's *dev server* (not the browser) forwards /api/* requests.
# This hop is server-to-server and never subject to browser CORS. Point it
# at wherever `uv run uvicorn app.main:app` (or `docker compose up`) is
# actually listening.
VITE_API_PROXY_TARGET=http://localhost:8000
