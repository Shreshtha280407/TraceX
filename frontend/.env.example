# Base URL of the TraceX FastAPI backend, no trailing slash and no /v1 suffix.
# Copy this file to .env.local and adjust for a hosted deployment; unset (or the
# default below) is correct for local dev against `uv run uvicorn app.main:app`.
VITE_API_BASE_URL=http://localhost:8000

# Firebase web app config for the TraceX frontend. This value is not a secret
# (it is embedded in every client bundle by design -- Firebase restricts access
# via Security Rules and authorized domains, not by keeping this config private),
# but it is still per-project, so it lives in .env rather than source.
#
# Copy this file to .env and fill in the values from:
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
