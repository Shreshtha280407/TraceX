{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceX address/script v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "network", "script_id", "script_type", "address", "representation_status", "source_refs"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "case_id": {"type": "string", "minLength": 1}, "network": {"type": "string", "minLength": 1},
    "script_id": {"type": "string", "minLength": 1}, "script_type": {"type": ["string", "null"]}, "address": {"type": ["string", "null"]},
    "representation_status": {"enum": ["decoded", "unrepresentable", "unknown"]},
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/source_ref"}}
  },
  "description": "An output lock representation, never a person, wallet, or ownership assertion."
}
