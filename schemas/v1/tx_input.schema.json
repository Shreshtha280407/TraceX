{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceX transaction input v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "network", "txid", "vin", "prev_txid", "prev_vout", "address", "amount_sats", "sequence", "source_refs"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "case_id": {"type": "string", "minLength": 1}, "network": {"type": "string", "minLength": 1}, "txid": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "vin": {"type": "integer", "minimum": 0}, "prev_txid": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "prev_vout": {"type": ["integer", "null"], "minimum": 0}, "address": {"type": ["string", "null"]}, "amount_sats": {"type": ["integer", "null"], "minimum": 0},
    "sequence": {"type": ["integer", "null"], "minimum": 0}, "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/source_ref"}}
  }
}
