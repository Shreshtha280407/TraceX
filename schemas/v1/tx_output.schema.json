{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceX transaction output v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "network", "txid", "vout", "amount_sats", "script_id", "script_type", "address", "source_refs"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "case_id": {"type": "string", "minLength": 1}, "network": {"type": "string", "minLength": 1}, "txid": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "vout": {"type": "integer", "minimum": 0}, "amount_sats": {"type": "integer", "minimum": 0, "maximum": 2100000000000000},
    "script_id": {"type": ["string", "null"]}, "script_type": {"type": ["string", "null"]}, "address": {"type": ["string", "null"]}, "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/source_ref"}}
  }
}
