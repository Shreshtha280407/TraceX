# install.sh replaces these placeholders with fresh random values.
TRACEX_SECRET_KEY=replace-with-random-secret
TRACEX_DB_PASSWORD=replace-with-random-password
TRACEX_IMAGE=tracex-appliance:latest
TRACEX_BIND=127.0.0.1
TRACEX_PORT=8000
TRACEX_UI_INTERNAL=true
TRACEX_ALLOW_DEV_ACTOR_HEADER=0
TRACEX_MEMORY_BUDGET_MB=2600
TRACEX_WORKERS=2
TRACEX_EXECUTION_MODE=bounded
TRACEX_ML_FINDINGS=1
TRACEX_ML_REVIEW_BUDGET=0.01
# Permit large local imports; these values do not disable hashing or admission.
TRACEX_MAX_UPLOAD_BYTES=68719476736
TRACEX_LEASE_SECONDS=600
