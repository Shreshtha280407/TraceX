__pycache__/
*.py[cod]
.pytest_cache/
.venv/
var/
*.egg-info/

# Firebase service-account private key (Admin SDK). Full-admin credential for
# the Firebase project -- never commit, never print, never share outside a
# secrets manager in production.
/secrets/
.env
.env.*
frontend/.env
frontend/.env.*

# Playwright MCP browser-automation snapshots/screenshots.
.playwright-mcp/

# Reproducible 100K fixture artifacts are generated locally from the pinned config.
/fixtures/demo_100k/*.ndjson
/fixtures/demo_100k/evaluation_truth.json

# Phase 5A's 10K development fixture is regenerated locally. Its compact
# manifest and evaluation-only truth are reviewed fixtures and remain tracked.
/fixtures/ml_smoke_10k/*.ndjson
/fixtures/ml_smoke_10k/evaluation_truth.json
/fixtures/ml_smoke_10k/fixture_manifest.json
!/fixtures/ml_smoke_10k/evaluation_truth.json
!/fixtures/ml_smoke_10k/fixture_manifest.json

# Locally generated Phase 5A 100K dataset artifacts.
/datasets/phase5a_100k/

# Phase 5B run outputs: feature packages, fitted model artifacts, candidate logs.
# Comparison/selection is reproducible from source + the fixture; nothing here is
# committed.
/experiments/runs/
