# Copy this file to `.env` and adjust as needed for local development.
# `.env` is git-ignored. Never commit real credentials.
#
# These values work out of the box with:
#   docker compose up -d postgres neo4j redis minio   (infra only, run API via `uv run uvicorn app.main:app --reload`)
#   docker compose up --build                          (full stack; compose.yaml overrides the *_DSN/*_URI/*_ENDPOINT
#                                                        values below with in-network service hostnames)

# --- Application ---
APP_NAME=tracex-api
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=tracex
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=tracex
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql+asyncpg://tracex:change-me-dev-only@localhost:5432/tracex

# --- Neo4j ---
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-dev-only
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_URI=bolt://localhost:7687

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=tracex-minio
MINIO_ROOT_PASSWORD=change-me-dev-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=tracex-minio
MINIO_SECRET_KEY=change-me-dev-only
MINIO_SECURE=false
MINIO_BUCKET=tracex-evidence

# --- Contracts ---
CONTRACT_VERSION=v1

# --- Authentication / access control ---
# Development-only placeholder, >= 32 chars (enforced at startup). Generate a
# real one for anything beyond a single developer's machine, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real secret, never share this value over chat/Git.
AUTH_JWT_SECRET=dev-only-change-me-32-characters-minimum-000
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=tracex-api
AUTH_JWT_AUDIENCE=tracex-clients
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
AUTH_LOGIN_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=20

# --- Evidence lifecycle ---
# Maximum bytes accepted for a single evidence upload (streamed in bounded
# chunks, never buffered in full). 200 MiB is a safe local-development
# default; raise it for real video evidence.
MAX_EVIDENCE_BYTES=209715200

# --- Worker job claim/result integration (Phase 2.1) ---
# How long (seconds) a claimed job is exclusively owned before its lease
# expires and it becomes eligible for another worker to reclaim.
WORKER_LEASE_SECONDS=300
# --- Worker retry limits and lease ceiling (Phase 3 -- Aditya) ---
# The absolute maximum a single claim's lease may ever be extended to via
# POST .../renew, measured from the original claim time -- no number of
# renewals can push a lease past this. Must be >= WORKER_LEASE_SECONDS.
WORKER_LEASE_MAX_SECONDS=3600
# How many times a job may be reclaimed after a lease expires before it is
# swept to a durable terminal `failed` state (error code `retry_exhausted`)
# instead of remaining reclaimable forever.
WORKER_JOB_MAX_ATTEMPTS=5
# Base URL a worker process (e.g. `uv run python -m
# app.modules.structured_processing.worker --once`) uses to reach the
# internal worker API. localhost:8000 is correct for the default "infra in
# Docker, API on host" workflow; point it at the api service's published
# port if running the worker against a fully containerized stack.
WORKER_API_BASE_URL=http://localhost:8000

# --- Worker identity (Phase 2 security hardening) ---
# See docs/architecture/worker-identity-and-security.md for the full
# credential lifecycle. The old single shared secret gating every worker
# identically has been removed, not kept as a fallback.
#
# Each worker *role* needs its own credential -- a shared token across
# structured-worker/communication-worker/media-worker means only one of
# their `worker_credentials` rows' digests can ever match, so the other
# two 403 on every claim (Gap-Closure follow-up: found via live multi-
# worker testing, since `docker compose --profile cpu-worker up` runs
# several worker containers at once but no test in this repo's own suite
# ever did). `Settings.worker_token` is one field, read identically by
# every worker module -- compose.yaml's per-service environment override
# (not app code) is what makes each container present its own role's
# credential; see structured-worker/communication-worker/media-worker's
# own `environment:` blocks there.
#
# Provision one credential per role with the trusted-operator CLI first --
# never by hand-editing this file:
#   uv run python -m app.modules.access_control.worker_credentials create \
#     --name structured-worker --processor fir_report_text_v1 \
#     --processor cdr_generic_v1 --processor financial_transaction_generic_v1 \
#     --processor generic_tabular_v1 --processor generic_json_v1
#   uv run python -m app.modules.access_control.worker_credentials create \
#     --name communication-worker --processor audio_metadata_v1 \
#     --processor transcript_import_v1 --processor diarization_import_v1 \
#     --processor whatsapp_export_v1 --processor telegram_export_v1 \
#     --processor instagram_export_v1 --processor generic_social_json_v1
#   uv run python -m app.modules.access_control.worker_credentials create \
#     --name media-worker --processor media_detection_v1 \
#     --processor media_metadata_v1
# Each CLI call prints its plaintext token exactly once, to your terminal
# only. Paste each into your own untracked .env -- never into this file,
# never into Git, a log line, a test report, or a screenshot.
STRUCTURED_WORKER_TOKEN=
COMMUNICATION_WORKER_TOKEN=
MEDIA_WORKER_TOKEN=
# WORKER_CREDENTIAL_PEPPER is *server-side*: a secret mixed into every
# stored worker-credential digest. Safe to leave blank in local
# development/test (falls back to an unkeyed digest, documented and
# intentional -- see the architecture doc); required when
# APP_ENV=production, where a missing value fails worker authentication
# closed with a clear, non-secret startup/request error rather than
# silently running unkeyed. Generate one the same way as AUTH_JWT_SECRET:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_CREDENTIAL_PEPPER=

# --- Admin provisioning (G5 gap closure) ---
# No public self-registration exists. Bootstrap the first admin with:
#   uv run python -m app.modules.access_control.cli create-admin --email a@example.test
# The CLI prompts for a password interactively unless this is set -- never
# put a real password in this file; export it in your shell before running
# the CLI, or leave unset to be prompted.
TRACEX_ADMIN_BOOTSTRAP_PASSWORD=

# --- Phase 4 LAN worker control-plane security ---
# Local development may use the explicit HTTP exception below. For a LAN or
# production-like deployment, terminate TLS at the API or a trusted reverse
# proxy, set this true, and list only proxy IPs permitted to supply
# X-Forwarded-Proto (comma-separated). Never list an untrusted LAN client.
WORKER_SECURE_TRANSPORT_REQUIRED=false
WORKER_TRUSTED_PROXY_IPS=
# Bounded control-plane JSON only; workers never upload raw media here.
WORKER_INTERNAL_REQUEST_MAX_BYTES=2097152
WORKER_INTERNAL_REQUEST_TIMEOUT_SECONDS=30
WORKER_BATCH_MAX_OBSERVATIONS=500
WORKER_BATCH_MAX_TRANSFORMATIONS=500
WORKER_MEDIA_CHUNK_MAX_ARTIFACTS=100
# A live lease with no renewal for this interval is operationally degraded;
# it remains safely retryable through the existing lease-expiry policy.
WORKER_HEARTBEAT_STALE_SECONDS=120

# Phase 4 local media analysis profile. `rapid` is bounded initial inspection;
# `deep` uses denser sampling and permits configured ROI OCR.
MEDIA_PROCESSING_PROFILE=rapid

# --- Graph projection (Phase 2 -- Shreshtha) ---
# See docs/architecture/graph-projection.md for the full design. Reuses the
# NEO4J_* settings above; these three control only the durable
# PostgreSQL-backed projection queue/lease policy, not Neo4j connectivity.
#
# How many queued projection jobs one `uv run python -m
# app.modules.graph.worker --once` invocation claims and processes before
# exiting.
GRAPH_PROJECTION_BATCH_SIZE=25
# How long (seconds) a claimed projection job is exclusively owned before
# its lease expires and it becomes eligible for another projector run to
# reclaim.
GRAPH_PROJECTION_LEASE_SECONDS=120
# A projection job whose lease keeps expiring is retried up to this many
# times before being left `failed` for operator inspection rather than
# retried forever.
GRAPH_PROJECTION_MAX_ATTEMPTS=5
# How often (seconds) `graph.worker --loop` renews a still-in-progress
# batch's projection-job leases, so a batch whose cumulative processing
# time approaches the lease window never risks a not-yet-reached job in it
# looking lease-expired to a concurrent projector run.
GRAPH_PROJECTION_RENEW_INTERVAL_SECONDS=40
# `graph.worker --loop` only: how long to sleep between empty poll
# attempts, the exponential-backoff ceiling on repeated failure, and how
# many consecutive failures stop the loop (an operator-visible problem,
# not something to retry forever silently). See
# docs/architecture/graph-projection.md's "Continuous operation".
GRAPH_PROJECTOR_POLL_INTERVAL_SECONDS=5
GRAPH_PROJECTOR_MAX_BACKOFF_SECONDS=60
GRAPH_PROJECTOR_MAX_CONSECUTIVE_FAILURES=5

# --- Phase 7 Gate C frozen release configuration ---
# Only an ID committed in configs/benchmarks/release-freeze.v1.json is valid.
# Set the disable switch to true for the auditable, fail-closed rollback;
# relationship scoring then stops before any case data is retrieved.
RELEASE_CONFIGURATION_ID=tracex-release-v1-baseline
RELEASE_CONFIGURATION_DISABLED=false

# --- Media detection/OCR (Phase 2 closeout) ---
# See docs/architecture/media-processing-worker.md's "Model asset
# bootstrap"/"OCR runtime setup" for the full design. No model weights are
# bundled in this repository or downloaded automatically -- run the
# documented bootstrap command first:
#   uv run python -m app.modules.media_processing.bootstrap_models
# (or, in Docker: `docker compose run --rm media-model-bootstrap`).
#
# Where the bootstrapped detector model file lives, and its expected
# SHA-256 -- both default to exactly what the bootstrap command produces,
# so the common case needs no override. See
# app/modules/media_processing/analysis/onnx_detector.py's "Model
# provenance" for the source/license/commit this is pinned to.
MEDIA_DETECTOR_MODEL_PATH=models/media/object_detection_yolox_2022nov.onnx
MEDIA_DETECTOR_MODEL_SHA256=c5c2d13e59ae883e6af3b45daea64af4833a4951c92d116ec270d9ddbe998063
# "auto" prefers a CUDA execution provider when the installed onnxruntime
# genuinely has one available (requires onnxruntime-gpu on a CUDA-capable
# host -- see pyproject.toml's [project.optional-dependencies] gpu group),
# and falls back to CPU otherwise. "cpu"/"cuda" force one or the other;
# "cuda" without a real CUDA provider available fails clearly at startup
# rather than silently running on CPU.
MEDIA_DETECTOR_DEVICE=auto
MEDIA_DETECTOR_CONFIDENCE_THRESHOLD=0.5
MEDIA_DETECTOR_NMS_THRESHOLD=0.5
# `eng` is the only tesseract language pack this repository's Dockerfile
# installs by default (tesseract-ocr's own Recommends). Install additional
# tesseract-ocr-<lang> system packages to add others.
MEDIA_OCR_LANGUAGE=eng
MEDIA_OCR_MIN_CONFIDENCE=0.3
# `media.worker --loop`/`--once` (a long-running video analysis may outlast
# the lease it was claimed under) and `--loop`'s poll/backoff policy -- same
# reasoning as the GRAPH_PROJECTOR_* settings above.
MEDIA_WORKER_RENEW_INTERVAL_SECONDS=60
MEDIA_WORKER_POLL_INTERVAL_SECONDS=5
MEDIA_WORKER_MAX_BACKOFF_SECONDS=60
MEDIA_WORKER_MAX_CONSECUTIVE_FAILURES=5

# --- Document page-OCR and local NER (Phase 3 -- Jasraj) ---
# See docs/architecture/document-structured-processing.md's "Real local
# OCR"/"Local NER bootstrap" for the full design. OCR reuses the same
# `tesseract` system binary MEDIA_OCR_LANGUAGE above already requires -- no
# separate install step.
DOCUMENT_OCR_LANGUAGE=eng
# Pixels-per-inch to render each PDF page at before OCR.
DOCUMENT_OCR_DPI=300
DOCUMENT_OCR_MIN_CONFIDENCE=0.4
# Where the bootstrapped local NER model directory lives, and the expected
# SHA-256 of the wheel `bootstrap_ner_model.py` downloads it from -- both
# default to exactly what that command produces, so the common case needs
# no override:
#   uv run python -m app.modules.structured_processing.bootstrap_ner_model
# No model weights are bundled in this repository or downloaded
# automatically at worker runtime. Without this bootstrap step, the worker
# automatically falls back to a deterministic, no-ML adapter -- never a
# crash.
NER_MODEL_PATH=models/nlp/en_core_web_sm
NER_MODEL_SHA256=1932429db727d4bff3deed6b34cfc05df17794f4a52eeb26cf8928f7c1a0fb85

# --- CDR/finance chunked batch processing (Phase 3 -- Jasraj) ---
# How many normalized records one micro-batch submits to Nipun's
# observation-batch endpoint at a time.
STRUCTURED_BATCH_SIZE=500
# The timezone a CDR/finance record's timestamp is interpreted in when the
# record itself carries no explicit source_timezone field -- never
# silently assumed to be UTC. Must be a valid IANA timezone name.
STRUCTURED_DEFAULT_TIMEZONE=Asia/Kolkata

# --- Audio/social-chat chunked batch processing (Phase 3 -- Sarthak) ---
# See docs/architecture/communication-processing.md for the full design.
# How many transcript/diarization segments or chat messages one
# micro-batch submits to Nipun's observation-batch endpoint at a time.
COMMUNICATION_BATCH_SIZE=200
# The timezone a chat message's timestamp is interpreted in when the
# message itself carries no explicit offset/Z/epoch signal -- never
# silently assumed to be UTC or the host machine's local time. Must be a
# valid IANA timezone name. Deliberately the same default as
# STRUCTURED_DEFAULT_TIMEZONE above -- both modules process the same
# class of India-context evidence.
COMMUNICATION_DEFAULT_TIMEZONE=Asia/Kolkata
# Phase 4 local-only ASR/diarization bridge. Each command is an absolute or
# deployment-relative executable path, never a shell command. It must use
# the documented JSON stdout protocol in phase-4-audio-social-worker.md.
# Leave these unset to defer raw-audio transcription safely. Do not commit
# model bundles or provide cloud/Hugging Face credentials.
COMMUNICATION_AUDIO_PROFILE=rapid
COMMUNICATION_ASR_COMMAND=
COMMUNICATION_ASR_MODEL_PATH=
COMMUNICATION_ASR_LANGUAGE=auto
COMMUNICATION_ASR_TIMEOUT_SECONDS=120
COMMUNICATION_DIARIZATION_COMMAND=
COMMUNICATION_DIARIZATION_MODEL_PATH=
COMMUNICATION_DIARIZATION_TIMEOUT_SECONDS=120

# --- Tamper-evident integrity checkpoints (Phase 6 -- Nipun) ---
# Local Ed25519 signing key for Merkle checkpoint roots (base64-encoded
# 32-byte raw private key). Generate a DEV-ONLY key with:
#   uv run python -m app.modules.integrity.cli generate-key
# Never commit a real key here or anywhere else -- this file only ships a
# blank placeholder. Leave unset to defer checkpoint signing safely (no
# crash; checkpoint creation fails clearly until a key is configured). See
# docs/runbooks/local-development.md.
INTEGRITY_SIGNING_KEY=
INTEGRITY_SIGNING_KEY_ID=dev-local-ed25519-1
# Gap-Closure WP-5 (G4): durable, write-once verification-bundle archival
# (`uv run python -m app.modules.integrity.cli archive`). The MinIO bucket
# is separate from raw evidence (MINIO_BUCKET above); the filesystem root
# is a repo-local scratch dir in dev, an operator-mounted volume in prod.
INTEGRITY_MANIFEST_BUCKET=tracex-integrity-manifests
INTEGRITY_MANIFEST_FILESYSTEM_ROOT=./data/integrity-manifests
